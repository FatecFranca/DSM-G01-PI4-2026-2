NODE_ENV=development
PORT=3333

# MongoDB: local (docker compose) ou a string do Atlas
MONGO_URI=mongodb://localhost:27017/paraflow

# segredo longo para assinar os tokens. para gerar um:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto-por-um-segredo-bem-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# endereços do site que podem chamar a API, separados por vírgula
CORS_ORIGINS=http://localhost:5173
# Em produção, site e API são servidos juntos após npm run build.
# No Render a URL é detectada por RENDER_EXTERNAL_URL.
PUBLIC_URL=
# Use 1 no Render; mantenha 0 ao acessar diretamente em desenvolvimento.
TRUST_PROXY_HOPS=0
# Opcional para revisar o build web pelo backend em ambiente local.
SERVE_WEB=false

# MQTT. deixe MQTT_URL vazio para rodar sem broker.
# local: mqtt://localhost:1883
# Wokwi: mqtt://broker.hivemq.com:1883 (broker público, então troque o prefixo por um nome só seu)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=paraflow

# libera o POST /api/eventos para simular peças sem hardware. em produção use false
ALLOW_SIMULATION=true
