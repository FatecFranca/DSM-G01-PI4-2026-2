{
  "expo": {
    "name": "Paraflow",
    "slug": "paraflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070b16",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.paraflow.app"
    },
    "android": {
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0a1628" },
      "package": "br.paraflow.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
